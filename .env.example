# Copy to .env and change what you need. Every value has a default, so a plain
# `docker compose up -d --build` works without this file.

# Password for the database container. Change it on anything that is not your laptop.
DB_PASSWORD=ec_dev_password

# Host ports. Change these if 5173, 5174 or 8080 are already taken on your machine.
WEB_PORT=5173
MOBILE_PORT=5174
BACKEND_PORT=8080
MOCK_PORT=9000

# Only used if something opens the API from a different origin.
PUBLIC_ORIGIN=http://localhost:5173

# Key for the simulated feed (profile "mock").
MOCK_API_KEY=hku-demo-key
